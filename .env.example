# Django
# Gere uma chave para ambientes reais; nunca versione o arquivo .env.
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend
DJANGO_LANGUAGE_CODE=pt-br
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# PostgreSQL
# localhost: aplicação executada no host com uv.
# No Docker Compose, POSTGRES_HOST é sobrescrito automaticamente para "database".
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=insights_brasil
POSTGRES_USER=insights_brasil
POSTGRES_PASSWORD=insights_brasil
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PORT_EXTERNAL=5432
DB_CONN_MAX_AGE=60

# Streamlit -> Django API (execução local com uv)
INSIGHTS_API_HOST=127.0.0.1
INSIGHTS_API_PORT=8000
